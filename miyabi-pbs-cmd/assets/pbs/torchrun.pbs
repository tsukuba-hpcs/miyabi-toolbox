#!/bin/bash
#PBS -q <eligible_g_batch_queue>
#PBS -W group_list=<literal_project_group>
#PBS -l select=<num_nodes>:mpiprocs=1
#PBS -l walltime=<HH:MM:SS>
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

# Bootstrap with host Python before using the project environment.
SKILL_ROOT="<absolute_skill_directory>"
TARGET_SYSTEM="Miyabi-G"
/usr/bin/python3 -I "$SKILL_ROOT/scripts/context.py" \
  --target-system "$TARGET_SYSTEM" --require-compute

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
REQUIRED_MODULES=(
  "<compiler-or-runtime-module/version>"
  "<mpi-module/version>"
)
for module_name in "${REQUIRED_MODULES[@]}"; do
  module load "$module_name"
done
module list 2>&1 | cat

# Use the project's intended checkout or code/config snapshot.
PROJECT_ROOT="<absolute_project_or_snapshot_root>"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
# Preserve the virtualenv symlink; do not use realpath/readlink -f here.
[[ "$PYTHON_BIN" = /* && -x "$PYTHON_BIN" ]] || { echo "Set an absolute executable PYTHON_BIN" >&2; exit 1; }
ENTRYPOINT="${ENTRYPOINT:-$PROJECT_ROOT/<entrypoint.py>}"
NPROC_PER_NODE="<local_workers_per_node>"
[[ "$NPROC_PER_NODE" =~ ^[1-9][0-9]*$ ]] || { echo "Set a positive local worker count" >&2; exit 1; }
RDZV_ID="${RDZV_ID:-$PBS_JOBID}"
DIST_BACKEND="${DIST_BACKEND:-nccl}"
# Optional compiler overrides, only after reproducing a compiler-specific failure.
RUNTIME_CC="${RUNTIME_CC:-}"
RUNTIME_CXX="${RUNTIME_CXX:-}"

if [[ -z "${MASTER_PORT:-}" ]]; then
  job_id="${PBS_JOBID:-}"
  job_number="${job_id%%.*}"
  if [[ "$job_number" =~ ^[0-9]+$ ]]; then
    MASTER_PORT=$((20000 + job_number % 20000))
  else
    MASTER_PORT=29500
  fi
fi

: "${PBS_NODEFILE:?PBS_NODEFILE is not set}"
cd "$PROJECT_ROOT"

mapfile -t HOSTS < <(awk '!seen[$0]++' "$PBS_NODEFILE")
NNODES="${#HOSTS[@]}"
if (( NNODES == 0 )); then
  echo "PBS_NODEFILE is empty" >&2
  exit 1
fi
WORLD_SIZE=$((NNODES * NPROC_PER_NODE))
MASTER_ADDR="${MASTER_ADDR:-${HOSTS[0]}}"
export PROJECT_ROOT PYTHON_BIN ENTRYPOINT NPROC_PER_NODE MASTER_ADDR MASTER_PORT RDZV_ID NNODES DIST_BACKEND

LOG_ROOT="${LOG_ROOT:-$PROJECT_ROOT/logs/$PBS_JOBID}"
mkdir -p "$LOG_ROOT"

MPI_ENV_ARGS=(
  "PROJECT_ROOT=$PROJECT_ROOT"
  "PYTHON_BIN=$PYTHON_BIN"
  "RUNTIME_CC=$RUNTIME_CC"
  "RUNTIME_CXX=$RUNTIME_CXX"
  "ENTRYPOINT=$ENTRYPOINT"
  "MASTER_ADDR=$MASTER_ADDR"
  "MASTER_PORT=$MASTER_PORT"
  "RDZV_ID=$RDZV_ID"
  "NNODES=$NNODES"
  "NPROC_PER_NODE=$NPROC_PER_NODE"
  "DIST_BACKEND=$DIST_BACKEND"
)

echo "NNODES=$NNODES NPROC_PER_NODE=$NPROC_PER_NODE WORLD_SIZE=$WORLD_SIZE"
echo "MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT"
echo "RDZV_ID=$RDZV_ID"
echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "LOG_ROOT=$LOG_ROOT"

# Replace with the project's actual argv, preserving array quoting.
TRAIN_ARGS=("<argument>")

mpirun \
  --mca mpi_abort_print_stack 1 \
  --report-bindings \
  --map-by ppr:1:node \
  --bind-to none \
  -np "$NNODES" \
  /usr/bin/env "${MPI_ENV_ARGS[@]}" \
  bash -lc '
    set -euo pipefail
    cd "$PROJECT_ROOT"
    # Apply deliberate overrides AFTER login/module initialization on each node.
    [[ -z "${RUNTIME_CC:-}" ]] || export CC="$RUNTIME_CC"
    [[ -z "${RUNTIME_CXX:-}" ]] || export CXX="$RUNTIME_CXX"
    export PYTHON_BIN
    node_rank="${OMPI_COMM_WORLD_RANK:?OMPI_COMM_WORLD_RANK is not set}"
    echo "torchrun supervisor host=$(hostname) node_rank=${node_rank}/${NNODES:?NNODES is not set}"
    echo "architecture=$(uname -m) python=$PYTHON_BIN CC=${CC:-unset} CXX=${CXX:-unset}"
    [[ "$(uname -m)" == aarch64 ]] || { echo "Miyabi-G worker architecture mismatch" >&2; exit 1; }
    exec "$PYTHON_BIN" -m torch.distributed.run \
      --rdzv-backend=c10d \
      --rdzv-endpoint="${MASTER_ADDR}:${MASTER_PORT}" \
      --rdzv-id="$RDZV_ID" \
      --nnodes="$NNODES" \
      --nproc-per-node="$NPROC_PER_NODE" \
      --node-rank="$node_rank" \
      --max-restarts=0 \
      "$ENTRYPOINT" "$@"
  ' bash "${TRAIN_ARGS[@]}" 2>&1 | tee "$LOG_ROOT/train.log"

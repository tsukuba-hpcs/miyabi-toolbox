#!/bin/bash
#PBS -q <eligible_batch_queue>
#PBS -W group_list=<literal_project_group>
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=<HH:MM:SS>
#PBS -j oe

# For bounded batch work; reuse an interactive allocation for iterative checks.
set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

# Absolute installed miyabi-pbs-cmd directory (provides the context guard).
MIYABI_PBS_CMD_ROOT="<absolute_miyabi-pbs-cmd_directory>"
TARGET_SYSTEM="<Miyabi-G_or_Miyabi-C>"
/usr/bin/python3 -I "$MIYABI_PBS_CMD_ROOT/scripts/context.py" \
  --target-system "$TARGET_SYSTEM" --require-compute

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
REQUIRED_MODULES=("<target_module/version>")
for module_name in "${REQUIRED_MODULES[@]}"; do
  module load "$module_name"
done
module list 2>&1 | cat

PROJECT_ROOT="<absolute_project_or_snapshot_root>"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
# Keep the virtualenv symlink. Export for nested tools as well.
[[ "$PYTHON_BIN" = /* && -x "$PYTHON_BIN" ]] || { echo "Set an absolute executable PYTHON_BIN" >&2; exit 1; }
export PYTHON_BIN
cd "$PROJECT_ROOT"

# Set only symptom-justified overrides, after module initialization.
[[ -z "${RUNTIME_CC:-}" ]] || export CC="$RUNTIME_CC"
[[ -z "${RUNTIME_CXX:-}" ]] || export CXX="$RUNTIME_CXX"
LOG_ROOT="${LOG_ROOT:-$PROJECT_ROOT/logs/$PBS_JOBID}"
mkdir -p "$LOG_ROOT"
"$PYTHON_BIN" -c 'import sys; print(sys.executable, sys.version, sys.prefix)'

# Replace with the project's actual entrypoint and argv, keeping array quoting.
WORKLOAD=("$PYTHON_BIN" "<entrypoint.py>" "<argument>")
"${WORKLOAD[@]}" 2>&1 | tee "$LOG_ROOT/workload.log"
